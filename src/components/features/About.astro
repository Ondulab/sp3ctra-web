---
import copy from "@content/copy/fr.json";
import SectionHeader from "@components/base/SectionHeader.astro";

const { title, subtitle, paragraphs } = copy.about;
---

<section class="container grid grid-cols-2 gap-12 py-16 md:py-24">
  <SectionHeader title={title} />

  <div class="mx-auto max-w-4xl">
    <div class="space-y-6">
      {paragraphs.map((paragraph) => <p class="text-muted text-lg leading-relaxed">{paragraph}</p>)}
    </div>
  </div>
</section>
