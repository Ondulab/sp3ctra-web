---
import { Picture } from "astro:assets";
import copy from "@content/copy/fr.json";
import SectionHeader from "@components/base/SectionHeader.astro";
import NewsCard from "@components/base/NewsCard.astro";
import expoCiteDesSciences from "@assets/images/blog/2025-10-18-cite-des-sciences/sp3ctra-cite-hero.jpg";

const { sectionTitle, expo2025 } = copy.news;
---

<section data-section="news" class="container flex flex-col gap-12 py-16 md:py-24">
  <SectionHeader title={sectionTitle} data-content="title" />
  <NewsCard content={expo2025} image={expoCiteDesSciences} />
</section>
