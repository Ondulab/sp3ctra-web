---
import copy from "@content/copy/fr.json";
import FeatureSection from "@components/base/FeatureSection.astro";
import MediaCard from "@components/base/MediaCard.astro";
import deviceImage from "@assets/images/device.jpg";
import expoImage from "@assets/images/sp3ctra_expo_la_musique_des_photons6.jpg";

const { title, description, items } = copy.research;

// Map item images to imported assets
const itemImages = [deviceImage, expoImage];
---

<FeatureSection title={title} description={description}>
  {
    items.map((item, index) => (
      <MediaCard
        src={itemImages[index]}
        alt={item.title}
        caption={item.title}
        href={item.link}
        linkType={item.linkType as "youtube" | "external" | "internal"}
      />
    ))
  }
</FeatureSection>
