---
import copy from "@content/copy/fr.json";
import FeatureSection from "@components/base/FeatureSection.astro";
import MediaCard from "@components/base/MediaCard.astro";
import deviceImage from "@assets/images/blog/2025-10-18-cite-des-sciences/sp3ctra-cite-exhibition-02.jpg";
import expoImage from "@assets/images/home/sp3ctra-research-score.jpg";
const { title, description, items } = copy.research;

const itemImages = [deviceImage, expoImage];
---

<FeatureSection title={title} description={description}>
  {
    items.map((item, index) => (
      <MediaCard src={itemImages[index]} alt={item.title} caption={item.title} />
    ))
  }
</FeatureSection>
