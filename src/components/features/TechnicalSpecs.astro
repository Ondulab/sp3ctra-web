---
import { Picture } from "astro:assets";
import copy from "@content/copy/fr.json";
import device from "@assets/images/home/sp3ctra-product-device.jpg";
import SectionHeader from "@components/base/SectionHeader.astro";

const { title, specs, tags, imageAlt } = copy.technicalSpecs;
---

<section class="container py-16 md:py-24">
  <div class="flex flex-col gap-12 lg:flex-row lg:gap-16">
    <div class="flex-3">
      <Picture
        src={device}
        alt={imageAlt}
        widths={[480, 640, 800]}
        formats={["avif", "webp"]}
        loading="lazy"
        class="h-auto w-full"
      />
    </div>

    <div class="flex-2 lg:max-w-lg">
      <SectionHeader title={title} />

      <dl class="mt-8 flex flex-col gap-4">
        {
          specs.map((spec) => (
            <div class="flex justify-between gap-4 border-b border-gray-700 pb-3">
              <dt class="text-muted text-sm">{spec.label}</dt>
              <dd class="text-foreground text-sm">{spec.value}</dd>
            </div>
          ))
        }
      </dl>

      <div class="mt-8 flex flex-wrap gap-3">
        {
          tags.map((tag) => (
            <span class="bg-surface text-foreground rounded-sm px-4 py-2 text-xs font-medium">
              {tag}
            </span>
          ))
        }
      </div>
    </div>
  </div>
</section>
