---
/**
 * EventGallery - Variation 2: Structured Grid Layout
 *
 * A clean, uniform grid with consistent image heights and responsive columns.
 * Images are cropped to fit grid cells, creating visual harmony and predictability.
 * Best for: Professional presentation, emphasizing uniformity and organization
 */

import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  content: {
    badge?: string;
    category: string;
    title: string;
    description: string;
    dates: string;
    location: string;
    access: string;
    imageAlt: string;
    link: string;
    linkText: string;
  };
}

const { content } = Astro.props;

// Import all images
import img1 from "@assets/images/cite-des-sciences/sp3ctra-2025-cite-des-sciences-ateliers-1.jpg";
import img2 from "@assets/images/cite-des-sciences/sp3ctra-2025-cite-des-sciences-ateliers-2.jpg";
import img3 from "@assets/images/cite-des-sciences/sp3ctra-2025-cite-des-sciences-ateliers-3.jpg";
import img4 from "@assets/images/cite-des-sciences/sp3ctra-2025-live-nuit-des-musees-1.jpg";
import img5 from "@assets/images/cite-des-sciences/sp3ctra-2025-live-nuit-des-musees-2.jpg";
import img6 from "@assets/images/cite-des-sciences/sp3ctra-2025-live-nuit-des-musees-3.jpg";
import img7 from "@assets/images/cite-des-sciences/sp3ctra-2025-musique-des-photons-exhibition-1.jpg";
import img8 from "@assets/images/cite-des-sciences/sp3ctra-2025-musique-des-photons-exhibition-2.jpg";
import img9 from "@assets/images/cite-des-sciences/sp3ctra-20251129-conference.jpg";

const images: Array<{ src: ImageMetadata; alt: string; category: string }> = [
  {
    src: img1,
    alt: "Atelier Sp3ctra à la Cité des Sciences - Participants explorant l'instrument",
    category: "Ateliers",
  },
  {
    src: img2,
    alt: "Atelier Sp3ctra - Vue rapprochée de l'interaction avec l'instrument",
    category: "Ateliers",
  },
  { src: img3, alt: "Atelier Sp3ctra - Groupe d'expérimentation sonore", category: "Ateliers" },
  { src: img4, alt: "Performance live Sp3ctra - Nuit des Musées", category: "Performance" },
  { src: img5, alt: "Performance live Sp3ctra - Captation en temps réel", category: "Performance" },
  { src: img6, alt: "Performance live Sp3ctra - Public et artiste", category: "Performance" },
  {
    src: img7,
    alt: "Exposition La musique des photons - Installation Sp3ctra",
    category: "Exhibition",
  },
  {
    src: img8,
    alt: "Exposition La musique des photons - Détails de l'instrument",
    category: "Exhibition",
  },
  { src: img9, alt: "Conférence de présentation Sp3ctra", category: "Conférence" },
];
---

<article
  class="from-surface/50 to-surface/30 border-border/50 relative overflow-hidden rounded-2xl border bg-linear-to-br backdrop-blur-sm"
>
  <div class="grid gap-0 lg:grid-cols-5">
    <!-- Event Information Sidebar -->
    <aside
      class="border-border/30 flex flex-col justify-between border-b p-6 md:p-8 lg:col-span-2 lg:border-r lg:border-b-0 lg:p-10"
    >
      <div>
        {
          content.badge && (
            <span class="mb-4 inline-block rounded-full border border-purple-500/30 bg-linear-to-r from-purple-500/20 to-blue-500/20 px-3 py-1 text-xs font-medium tracking-wider text-purple-300 uppercase">
              {content.badge}
            </span>
          )
        }

        <p class="text-accent mb-2 text-sm font-medium">{content.category}</p>
        <h3 class="mb-4 font-mono text-2xl font-semibold md:text-3xl">{content.title}</h3>

        <p class="text-foreground/80 mb-6 text-sm leading-relaxed">{content.description}</p>

        <div class="mb-8 space-y-3">
          <div class="flex items-start gap-3">
            <svg
              class="text-accent mt-0.5 h-5 w-5 shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
              ></path>
            </svg>
            <div>
              <p class="text-foreground/50 mb-1 text-xs tracking-wide uppercase">Dates</p>
              <p class="text-sm font-medium">{content.dates}</p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <svg
              class="text-accent mt-0.5 h-5 w-5 shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
              ></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <div>
              <p class="text-foreground/50 mb-1 text-xs tracking-wide uppercase">Lieu</p>
              <p class="text-sm font-medium">{content.location}</p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <svg
              class="text-accent mt-0.5 h-5 w-5 shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <div>
              <p class="text-foreground/50 mb-1 text-xs tracking-wide uppercase">Accès</p>
              <p class="text-foreground/70 text-sm">{content.access}</p>
            </div>
          </div>
        </div>
      </div>

      <a
        href={content.link}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-linear-to-r from-purple-500 to-blue-500 px-6 py-3 font-medium text-white transition-all duration-200 hover:from-purple-600 hover:to-blue-600 hover:shadow-lg hover:shadow-purple-500/25"
      >
        <span>{content.linkText}</span>
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
        </svg>
      </a>
    </aside>

    <!-- Grid Gallery -->
    <div class="p-6 md:p-8 lg:col-span-3">
      <div class="grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-4">
        {
          images.map((image) => (
            <div class="group relative aspect-square overflow-hidden rounded-lg">
              <Picture
                src={image.src}
                alt={image.alt}
                formats={["avif", "webp"]}
                widths={[300, 400, 600]}
                sizes="(max-width: 768px) 50vw, 33vw"
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-110"
              />
              <div class="absolute inset-0 flex items-end bg-linear-to-t from-black/70 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                <div class="p-3">
                  <p class="text-xs font-medium tracking-wide text-white uppercase">
                    {image.category}
                  </p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</article>
