---
/**
 * EventGallery - Variation 1: Masonry Layout
 *
 * A Pinterest-style masonry grid that naturally accommodates different image aspect ratios.
 * Images flow in columns with varying heights, creating an organic, dynamic feel.
 * Best for: Showcasing diverse content types (workshops, performances, exhibitions)
 */

import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  content: {
    badge?: string;
    category: string;
    title: string;
    description: string;
    dates: string;
    location: string;
    access: string;
    imageAlt: string;
    link: string;
    linkText: string;
  };
}

const { content } = Astro.props;

// Import all images
import img1 from "@assets/images/cite-des-sciences/sp3ctra-2025-cite-des-sciences-ateliers-1.jpg";
import img2 from "@assets/images/cite-des-sciences/sp3ctra-2025-cite-des-sciences-ateliers-2.jpg";
import img3 from "@assets/images/cite-des-sciences/sp3ctra-2025-cite-des-sciences-ateliers-3.jpg";
import img4 from "@assets/images/cite-des-sciences/sp3ctra-2025-live-nuit-des-musees-1.jpg";
import img5 from "@assets/images/cite-des-sciences/sp3ctra-2025-live-nuit-des-musees-2.jpg";
import img6 from "@assets/images/cite-des-sciences/sp3ctra-2025-live-nuit-des-musees-3.jpg";
import img7 from "@assets/images/cite-des-sciences/sp3ctra-2025-musique-des-photons-exhibition-1.jpg";
import img8 from "@assets/images/cite-des-sciences/sp3ctra-2025-musique-des-photons-exhibition-2.jpg";
import img9 from "@assets/images/cite-des-sciences/sp3ctra-20251129-conference.jpg";

const images: Array<{ src: ImageMetadata; alt: string; category: string }> = [
  {
    src: img1,
    alt: "Atelier Sp3ctra à la Cité des Sciences - Participants explorant l'instrument",
    category: "Ateliers",
  },
  {
    src: img2,
    alt: "Atelier Sp3ctra - Vue rapprochée de l'interaction avec l'instrument",
    category: "Ateliers",
  },
  { src: img3, alt: "Atelier Sp3ctra - Groupe d'expérimentation sonore", category: "Ateliers" },
  { src: img4, alt: "Performance live Sp3ctra - Nuit des Musées", category: "Performance" },
  { src: img5, alt: "Performance live Sp3ctra - Captation en temps réel", category: "Performance" },
  { src: img6, alt: "Performance live Sp3ctra - Public et artiste", category: "Performance" },
  {
    src: img7,
    alt: "Exposition La musique des photons - Installation Sp3ctra",
    category: "Exhibition",
  },
  {
    src: img8,
    alt: "Exposition La musique des photons - Détails de l'instrument",
    category: "Exhibition",
  },
  { src: img9, alt: "Conférence de présentation Sp3ctra", category: "Conférence" },
];
---

<article
  class="from-surface/50 to-surface/30 border-border/50 relative overflow-hidden rounded-2xl border bg-linear-to-br backdrop-blur-sm"
>
  <!-- Event Information Header -->
  <header class="border-border/30 border-b p-6 md:p-8 lg:p-12">
    <div class="max-w-3xl">
      {
        content.badge && (
          <span class="mb-4 inline-block rounded-full border border-purple-500/30 bg-linear-to-r from-purple-500/20 to-blue-500/20 px-3 py-1 text-xs font-medium tracking-wider text-purple-300 uppercase">
            {content.badge}
          </span>
        )
      }

      <p class="text-accent mb-2 text-sm font-medium">{content.category}</p>
      <h3 class="mb-4 font-mono text-3xl font-semibold md:text-4xl">{content.title}</h3>

      <div class="text-foreground/80 mb-6 space-y-3">
        <p class="text-base leading-relaxed">{content.description}</p>

        <div class="flex flex-col gap-2 text-sm font-medium sm:flex-row sm:gap-6">
          <div class="flex items-center gap-2">
            <svg class="text-accent h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
              ></path>
            </svg>
            <span>{content.dates}</span>
          </div>

          <div class="flex items-center gap-2">
            <svg class="text-accent h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
              ></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <span>{content.location}</span>
          </div>
        </div>

        <p class="text-foreground/60 text-sm italic">{content.access}</p>
      </div>

      <a
        href={content.link}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-lg bg-linear-to-r from-purple-500 to-blue-500 px-6 py-3 font-medium text-white transition-all duration-200 hover:from-purple-600 hover:to-blue-600 hover:shadow-lg hover:shadow-purple-500/25"
      >
        <span>{content.linkText}</span>
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
        </svg>
      </a>
    </div>
  </header>

  <!-- Masonry Gallery -->
  <div class="p-6 md:p-8 lg:p-12">
    <div class="columns-1 gap-4 space-y-4 sm:columns-2 lg:columns-3">
      {
        images.map((image) => (
          <div class="group relative break-inside-avoid overflow-hidden rounded-lg">
            <Picture
              src={image.src}
              alt={image.alt}
              formats={["avif", "webp"]}
              widths={[400, 600, 800]}
              sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
              loading="lazy"
              class="h-auto w-full transition-transform duration-300 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100">
              <div class="absolute right-0 bottom-0 left-0 p-4">
                <p class="text-xs font-medium tracking-wide text-white uppercase">
                  {image.category}
                </p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</article>
