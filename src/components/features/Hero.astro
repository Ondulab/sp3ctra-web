---
import { Picture, Image } from "astro:assets";

import copy from "@content/copy/fr.json";
import heroImage from "@assets/images/home/sp3ctra-hero-main.jpg";
import palmIcon from "@icons/palm.svg";
import Button from "@components/base/Button.astro";
import ArrowRight from "@lucide/astro/icons/arrow-right";

const emailHref = `mailto:${copy.contact.mail}?subject=${encodeURIComponent(copy.contact.subject)}`;
---

<section class="container mx-auto flex min-h-screen flex-col gap-12 py-16 md:gap-16">
  <!-- Content block -->
  <div class="flex flex-col gap-8">
    <!-- Title and subtitle -->
    <div class="border-foreground flex flex-col gap-6 border-l-2 pl-6">
      <h1
        class="text-foreground text-3xl leading-tight font-normal whitespace-pre-line md:text-5xl"
      >
        {copy.hero.title}
      </h1>

      <p class="text-muted max-w-prose text-base">
        {copy.hero.subtitle}
      </p>
    </div>

    <!-- CTA buttons -->
    <div class="flex flex-wrap gap-3">
      <Button href={emailHref} variant="primary" size="lg" icon={ArrowRight} iconPos="right">
        {copy.buttons.quote}
      </Button>

      <Button href="#about" variant="secondary" size="lg">
        {copy.buttons.more}
      </Button>
    </div>
  </div>

  <!-- Hero image -->
  <div class="w-full overflow-hidden">
    <Picture
      src={heroImage}
      alt="Sp3ctra - Dispositif de captation linéaire innovant pour la création sonore et visuelle en temps réel"
      widths={[640, 1024, 1280, 1920]}
      formats={["avif", "webp"]}
      loading="eager"
      fetchpriority="high"
      data-fade-in
      class="w-full opacity-0 transition-opacity duration-300"
    />
  </div>

  <!-- Recognition badge -->
  <div class="flex items-center justify-center gap-3">
    <Image src={palmIcon} alt="" class="size-8 shrink-0" aria-hidden="true" loading="eager" />

    <p class="text-foreground text-center text-sm leading-normal">
      {copy.hero.recognition}
    </p>

    <Image
      src={palmIcon}
      alt=""
      class="size-8 shrink-0 -scale-x-100"
      aria-hidden="true"
      loading="eager"
    />
  </div>
</section>
