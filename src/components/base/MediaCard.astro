---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Youtube from "@lucide/astro/icons/youtube";
import ExternalLink from "@lucide/astro/icons/external-link";
import Link from "@lucide/astro/icons/link";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  showCaption?: boolean;
  href?: string;
  linkType?: "youtube" | "external" | "internal";
  loading?: "lazy" | "eager";
  "data-content"?: string;
}

const {
  src,
  alt,
  caption,
  showCaption = true,
  href,
  linkType = "internal",
  loading = "lazy",
  "data-content": dataContent,
} = Astro.props;

const getLinkIcon = () => {
  switch (linkType) {
    case "youtube":
      return Youtube;
    case "external":
      return ExternalLink;
    case "internal":
      return Link;
    default:
      return Link;
  }
};

const IconComponent = getLinkIcon();
const isClickable = !!href;
const Component = isClickable ? "a" : "div";
const linkProps = isClickable
  ? {
      href,
      target: linkType === "external" || "youtube" ? "_blank" : undefined,
      rel: linkType === "external" || "youtube" ? "noopener noreferrer" : undefined,
    }
  : {};
---

<Component
  {...linkProps}
  class:list={[
    "group border-border bg-surface relative aspect-video w-full overflow-hidden border transition-all duration-300",
    { "hover:border-foreground cursor-pointer": isClickable },
  ]}
>
  <!-- Image -->
  <Image
    src={src}
    alt={alt}
    class:list={[
      "h-full w-full object-cover transition-transform duration-300",
      { "group-hover:scale-105": isClickable },
    ]}
    loading={loading}
  />

  <!-- Hover overlay with icon (only if clickable) -->
  {
    isClickable && (
      <div class="absolute inset-0 flex items-center justify-center bg-black/40 opacity-0 transition-opacity duration-300 group-hover:opacity-100">
        <IconComponent class="text-foreground h-16 w-16" />
      </div>
    )
  }

  <!-- Caption (if provided and showCaption is true) -->
  {
    caption && showCaption && (
      <div class="border-border absolute right-0 bottom-0 left-0 border-t bg-black/70 px-4 py-3 backdrop-blur-sm">
        <div class="flex items-center gap-2">
          {isClickable && <IconComponent class="text-foreground h-5 w-5 shrink-0" />}
          <p data-content={dataContent} class="text-foreground text-sm font-medium">
            {caption}
          </p>
        </div>
      </div>
    )
  }
</Component>
