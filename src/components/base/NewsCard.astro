---
/**
 * NewsCard - Unified news/event card component
 * Supports two variants: full (with image) and compact (without image)
 */

import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import { MapPin, Calendar, Navigation, ExternalLink, ArrowRight } from "@lucide/astro";
import Button from "@components/base/Button.astro";

interface NewsContent {
  badge?: string;
  category: string;
  title: string;
  description: string;
  dates: string;
  location: string;
  access?: string;
  imageAlt?: string;
  link: string;
  linkText?: string;
}

interface Props {
  content: NewsContent;
  image?: ImageMetadata;
  variant?: "full" | "compact";
}

const { content, image, variant = "full" } = Astro.props;
const { badge, category, title, description, dates, location, access, imageAlt, link, linkText } =
  content;

// Determine variant based on image presence if not explicitly set
const actualVariant = variant === "full" && !image ? "compact" : variant;
---

{
  actualVariant === "full" ? (
    <article class="relative">
      <div class="bg-surface border-border grid gap-0 overflow-hidden rounded border md:grid-cols-2">
        {image && (
          <div class="overflow-hidden">
            <Picture
              src={image}
              alt={imageAlt || title}
              widths={[400, 600, 800]}
              formats={["avif", "webp"]}
              loading="lazy"
              class="h-full w-full object-cover"
            />
          </div>
        )}

        <div class="flex flex-col justify-center gap-8 p-8 md:p-12">
          <div class="text-primary font-mono text-xs font-semibold tracking-widest uppercase">
            {category}
          </div>

          <h3 class="text-foreground text-2xl leading-tight font-semibold">{title}</h3>

          <p class="text-muted text-base leading-relaxed">{description}</p>

          <div class="border-primary text-muted flex flex-col gap-4 text-sm">
            <div class="flex items-start gap-3">
              <Calendar />
              <div class="mt-1">{dates}</div>
            </div>

            <div class="flex items-start gap-3">
              <MapPin />
              <div class="mt-1">{location}</div>
            </div>
          </div>

          <Button
            variant="link"
            href={link}
            icon={ArrowRight}
            iconPos="right"
            ariaLabel={linkText}
            size="none"
          >
            {linkText}
          </Button>
        </div>
      </div>
    </article>
  ) : (
    <div class="flex h-full flex-col justify-between">
      <div>
        {badge && (
          <span class="bg-gradient-primary-overlay border-primary/30 text-primary mb-4 inline-block rounded-full border px-3 py-1 text-xs font-medium tracking-wider uppercase">
            {badge}
          </span>
        )}

        <p class="text-accent mb-2 font-mono text-sm font-medium tracking-widest uppercase">
          {category}
        </p>
        <h3 class="text-foreground mb-4 font-mono text-2xl leading-tight font-semibold md:text-3xl">
          {title}
        </h3>

        <p class="text-foreground/80 mb-6 text-sm leading-relaxed">{description}</p>

        <div class="border-accent/30 mb-6 space-y-3 border-l-2 pl-4">
          <div class="flex items-start gap-3">
            <Calendar class="text-accent mt-0.5 shrink-0" size={16} />
            <div>
              <p class="text-foreground/50 mb-0.5 font-mono text-xs tracking-wide uppercase">
                Dates
              </p>
              <p class="text-foreground text-sm font-medium">{dates}</p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <MapPin class="text-accent mt-0.5 shrink-0" size={16} />
            <div>
              <p class="text-foreground/50 mb-0.5 font-mono text-xs tracking-wide uppercase">
                Lieu
              </p>
              <p class="text-foreground text-sm font-medium">{location}</p>
            </div>
          </div>

          {access && (
            <div class="flex items-start gap-3">
              <Navigation class="text-accent mt-0.5 shrink-0" size={16} />
              <div>
                <p class="text-foreground/50 mb-0.5 font-mono text-xs tracking-wide uppercase">
                  Accès
                </p>
                <p class="text-foreground/70 text-sm">{access}</p>
              </div>
            </div>
          )}
        </div>
      </div>

      <a
        href={link}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-gradient-primary hover:shadow-primary/25 inline-flex w-full items-center justify-center gap-2 rounded-lg px-5 py-2.5 text-sm font-medium text-white transition-all duration-200 hover:opacity-90 hover:shadow-lg"
      >
        <span>{linkText || "En savoir plus"}</span>
        <ExternalLink size={16} />
      </a>
    </div>
  )
}
