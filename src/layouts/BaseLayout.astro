---
// SEO
import copy from "@content/copy/fr.json";

import BackgroundSpectrum from "@components/layout/BackgroundSpectrum.astro";

const title = copy.seo.title;
const description = copy.seo.description;
const structuredDescription = copy.seo.structuredDescription;
const ogImage = copy.seo.ogImage;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

import "../styles/global.css";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Jérôme Abel" />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <link rel="canonical" href={canonicalURL} />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Product",
            name: "Sp3ctra",
            description: structuredDescription,
            image: "https://sp3ctra.io/images/og-image.jpg",
            brand: {
              "@type": "Brand",
              name: "Sp3ctra",
            },
          },
          {
            "@type": "Organization",
            name: "Sp3ctra",
            url: "https://sp3ctra.io",
            logo: "https://sp3ctra.io/favicon.svg",
            contactPoint: {
              "@type": "ContactPoint",
              email: "contact@sp3ctra.io",
              contactType: "Customer Support",
            },
          },
        ],
      })}
    />

    <meta http-equiv="Cache-control" content="public" />

    <script>
      import "@features/analytics/init";
    </script>
  </head>
  <body class="relative grid min-h-screen auto-rows-[auto_1fr_auto]">
    <BackgroundSpectrum />
    <slot />
    <script>
      import { initFadeInImages } from "@scripts/animations";
      initFadeInImages();
    </script>
  </body>
</html>
